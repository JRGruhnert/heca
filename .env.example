# Default: <repository>/data
HECA_DATA=/export/$USER/heca/data

# wandb: keep its run directories off the home quota, and go offline on
# compute nodes without internet access (`wandb sync wandb/offline-run-*` later).
WANDB_DIR=/export/$USER/heca/wandb
WANDB_MODE=online

# Headless rendering on a machine without a display.
MUJOCO_GL=egl
