# Shared configuration for ./upload_data.sh and ./download_data.sh
#
# Every value can be overridden on the command line or from the environment,
# so both scripts stay in sync through this single file. Commit this file:
# after the first upload you paste the resulting link into DATA_URL /
# ZENODO_RECORD so that a fresh clone can fetch the data with one command.

# --- what to bundle -------------------------------------------------------
DATA_DIR="${DATA_DIR:-data}"
BUNDLE_ZIP="${BUNDLE_ZIP:-data.zip}"
# <BUNDLE_ZIP>.sha256 and <BUNDLE_ZIP>.manifest.txt are derived from BUNDLE_ZIP
# by both scripts, so they always sit next to the archive.

# Patterns excluded from the archive (zip syntax, matched against the stored
# path, so "*" also matches "/"). Default: the raw demos and any nested archive
# - both are large and can be regenerated / re-downloaded separately.
BUNDLE_EXCLUDES="${BUNDLE_EXCLUDES:-*.h5 *.zip}"

# Extra patterns used by --trim: cached CALVIN frames, old experiment results
# and generated plots. --trim takes the bundle from ~32 GB to ~6.5 GB.
BUNDLE_TRIM_EXCLUDES="${BUNDLE_TRIM_EXCLUDES:-*/old/* */calvin/* *.png}"

# --- where it goes --------------------------------------------------------
# zenodo : upload with curl + a Zenodo token, download via public URL (default)
# rclone : any rclone remote (gdrive:, dropbox:, onedrive:, s3:, ...)
# url    : download only, from DATA_URL (Google Drive / Dropbox share link)
# file   : download only, from a local path (USB stick, network share)
BUNDLE_BACKEND="${BUNDLE_BACKEND:-zenodo}"

# Zenodo: create a personal access token with "deposit:write" + "deposit:actions"
# at https://zenodo.org/account/settings/applications/tokens/new/, then
#   export ZENODO_TOKEN=...
# Use https://sandbox.zenodo.org/api to rehearse an upload without publishing.
ZENODO_API="${ZENODO_API:-https://zenodo.org/api}"
ZENODO_RECORD="${ZENODO_RECORD:-}"   # e.g. 1234567, filled in by upload_data.sh

# rclone remote and path, e.g. gdrive:heca-data or dropbox:heca/heca-data
RCLONE_REMOTE="${RCLONE_REMOTE:-gdrive:heca-data}"

# Direct link to the zip, used by --backend url / as a fallback (any host).
DATA_URL="${DATA_URL:-}"
